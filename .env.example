# Shared
OMS_TIMEZONE=Asia/Seoul

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
OMS_FILE_STORAGE_PATH=./.local/uploads

# Database is not finalized. MySQL is the first MVP candidate; PostgreSQL remains a comparison option.
OMS_DATABASE_VENDOR=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/oms
SPRING_DATASOURCE_USERNAME=oms
SPRING_DATASOURCE_PASSWORD=change-me

# External API
OMS_EXTERNAL_API_KEY=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_EXTERNAL_API_BASE_URL=http://localhost:8080/external/v1
# Local profile currently accepts X-User-Id for protected admin APIs.
VITE_DEV_USER_ID=1
